# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Local config & secrets (use the .example files as templates)
config/config.yaml
prompts/system_prompt.md
.anthropic_key

# Daily materials & rendered output — keep these out of git
input/*
!input/.gitkeep
output/*
!output/.gitkeep
state/*
!state/.gitkeep

# Bundled fonts are downloaded by setup; don't commit large binaries
assets/fonts/*
!assets/fonts/.gitkeep

# xiaohongshu-mcp server binaries / data (downloaded & generated locally)
vendor/
mcp_data/
data/
cookies.json
*.log

# macOS
.DS_Store
